// إضافات مقترحة على gff-backend/prisma/schema.prisma عشان "رادار" والمتابعة تشتغل.
// ده اقتراح للمراجعة، مش migration جاهزة.
//
// ماشي على نفس اتفاقيات السكيما الحالية:
// - كل حقل من أكتر من كلمة ليه @map بـ snake_case.
// - كل جدول ليه @@map بالجمع.
// - كل جدول رئيسي فيه companyId.
// - الـ back-relations المطلوبة في Customer و Company مكتوبة كتعليقات جنب كل قسم.
//
// الترتيب:
// - المرحلة 2: A و B.
// - المرحلة 3: الباقي.

// ───────────── A. توسيع Customer (المرحلة 2) ─────────────
// يتضاف جوه model Customer:
//   segment            BreederSegment? @map("segment")
//   subSegment         String?         @map("sub_segment")          // H1|H2|H3|H4|S1|S2|S3|S4|UNKNOWN (segments.md)
//   governorate        String?
//   markaz             String?
//   village            String?
//   latitude           Decimal?        @db.Decimal(10, 6)
//   longitude          Decimal?        @db.Decimal(10, 6)
//   whatsappPhone      String?         @map("whatsapp_phone")
//   contactConsent     Boolean         @default(false) @map("contact_consent")
//   consentAt          DateTime?       @map("consent_at")
//   consentSource      String?         @map("consent_source")       // rep | branch | whatsapp_optin
//   optOutAt           DateTime?       @map("opt_out_at")
//   acquisitionSource  String?         @map("acquisition_source")   // rep | branch | referral | ad
//   lifecycleStage     LifecycleStage? @map("lifecycle_stage")      // من غير default: يتحسب من تاريخ الفواتير بعد الـ migration
//   lifecycleUpdatedAt DateTime?       @map("lifecycle_updated_at")
//   herds              CustomerHerd[]
//   @@index([segment])
//   @@index([governorate])
//   @@index([lifecycleStage])
//
// خطوة backfill بعد الـ migration: lifecycleStage = ACTIVE / DORMANT / CHURNED حسب آخر فاتورة (أقل من 6 شهور / 6-12 / أكتر من 12).

enum BreederSegment {
  HOUSEHOLD // تربية منزلية
  SMALL_FARM // مزرعة صغيرة
  MEDIUM_FARM
  COMMERCIAL
}

enum LifecycleStage {
  LEAD
  NEW
  ACTIVE
  GROWING
  KEY
  AT_RISK
  DORMANT
  CHURNED
}

// ───────────── B. القطيع / الطيور عند العميل (المرحلة 2) ─────────────
// يتضاف جوه model Company: customerHerds CustomerHerd[]
enum Species {
  BROILER
  LAYER
  BALADI_CHICKEN
  SASSO
  DUCK
  GOOSE
  TURKEY
  PIGEON
  QUAIL
  RABBIT
  CATTLE
  BUFFALO
  SHEEP
  GOAT
  CAMEL
  FISH
  OTHER
}

enum HerdPurpose {
  MEAT
  EGGS
  MILK
  FATTENING
  BREEDING
  MIXED
}

enum FeedSource {
  GFF
  COMPETITOR
  HOME_MIX
  LOCAL_MILL
  MIXED
  UNKNOWN
}

enum DataSource {
  REP
  SURVEY
  WHATSAPP
  AGENT_INFERRED
}

model CustomerHerd {
  id                String      @id @default(uuid())
  companyId         String      @map("company_id")
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId        String      @map("customer_id")
  customer          Customer    @relation(fields: [customerId], references: [id])
  species           Species
  headCount         Int         @map("head_count")
  purpose           HerdPurpose
  cycleStartDate    DateTime?   @map("cycle_start_date")
  expectedCycleEnd  DateTime?   @map("expected_cycle_end")
  currentFeedSource FeedSource  @default(UNKNOWN) @map("current_feed_source")
  currentFeedBrand  String?     @map("current_feed_brand")
  monthlyFeedKg     Decimal?    @map("monthly_feed_kg") @db.Decimal(10, 2)
  dataSource        DataSource  @map("data_source")
  recordedById      String      @map("recorded_by_id")
  recordedAt        DateTime    @default(now()) @map("recorded_at")

  @@index([companyId])
  @@index([customerId])
  @@index([species])
  @@map("customer_herds")
}

// ───────────── C. سجل التفاعلات (المرحلة 3) ─────────────
// يتضاف جوه model Customer مع القسم ده: interactions CustomerInteraction[]
// ويتضاف جوه model Company: customerInteractions CustomerInteraction[]
enum InteractionType {
  CALL
  VISIT
  WHATSAPP_IN
  WHATSAPP_OUT
  COMPLAINT
  SURVEY
  INTERVIEW
  WALK_IN
}

model CustomerInteraction {
  id         String          @id @default(uuid())
  companyId  String          @map("company_id")
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String          @map("customer_id")
  customer   Customer        @relation(fields: [customerId], references: [id])
  type       InteractionType
  summary    String
  rawText    String?         @map("raw_text")
  sentiment  Int? // -2 .. +2
  tags       String[]
  productId  String?         @map("product_id")
  userId     String          @map("user_id")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([companyId])
  @@index([customerId, createdAt])
  @@map("customer_interactions")
}

// ───────────── D. رسايل واتساب (المرحلة 3) ─────────────
// الخدمة الحالية بتخزن الرسايل في الذاكرة المؤقتة وبتضيع.
// يتضاف جوه model Company: whatsappMessages WhatsAppMessage[]
model WhatsAppMessage {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  waMessageId  String   @unique @map("wa_message_id")
  customerId   String?  @map("customer_id")
  phone        String
  direction    String // IN | OUT
  type         String
  body         String?
  templateName String?  @map("template_name")
  status       String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([customerId])
  @@map("whatsapp_messages")
}

// ───────────── E. الاستبيانات (المرحلة 3) ─────────────
// يتضاف جوه model Company: surveys Survey[]
enum SurveyStatus {
  DRAFT
  APPROVED
  LIVE
  CLOSED
}

model Survey {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  purpose       String
  targetSegment BreederSegment?  @map("target_segment")
  targetSpecies Species?         @map("target_species")
  questions     Json
  channel       String // REP | WHATSAPP
  status        SurveyStatus     @default(DRAFT)
  createdById   String           @map("created_by_id")
  approvedById  String?          @map("approved_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  responses     SurveyResponse[]

  @@index([companyId])
  @@map("surveys")
}

model SurveyResponse {
  id           String   @id @default(uuid())
  surveyId     String   @map("survey_id")
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  customerId   String?  @map("customer_id")
  responseCode String?  @map("response_code") // رقم استبيان لغير العملاء (F4-001)
  answers      Json
  collectedVia String   @map("collected_via") // REP | WHATSAPP
  collectedAt  DateTime @default(now()) @map("collected_at")

  @@index([surveyId])
  @@map("survey_responses")
}

// ───────────── F. مسار المنتجات الجديدة (المرحلة 3) ─────────────
// يتضاف جوه model Company: productIdeas ProductIdea[]
enum IdeaStage {
  IDEA
  DESK_RESEARCH
  FIELD_VALIDATION
  PILOT
  LAUNCHED
  REVIEW_90D
  STOPPED
}

model ProductIdea {
  id                String           @id @default(uuid())
  companyId         String           @map("company_id")
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code              String // OPP-001
  title             String
  description       String
  category          String // FEED | PULSES | VET | SUPPLIES | ADDITIVE | SERVICE
  targetSpecies     Species[]        @map("target_species")
  targetSegment     BreederSegment[] @map("target_segment")
  problemStatement  String           @map("problem_statement")
  evidence          Json
  estPriceEgp       Decimal?         @map("est_price_egp") @db.Decimal(12, 2)
  estUnitCostEgp    Decimal?         @map("est_unit_cost_egp") @db.Decimal(12, 2)
  needsRegistration Boolean          @default(false) @map("needs_registration")
  stage             IdeaStage        @default(IDEA)
  score             Decimal?         @db.Decimal(4, 1) // من 35
  pilotBranchId     String?          @map("pilot_branch_id")
  createdById       String           @map("created_by_id")
  ownerId           String           @map("owner_id")
  decidedById       String?          @map("decided_by_id")
  decidedAt         DateTime?        @map("decided_at")
  launchedProductId String?          @map("launched_product_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@map("product_ideas")
}

// يتضاف جوه model Product:

// ───────────── G. أسعار السوق (المرحلة 3) ─────────────
// يتضاف جوه model Company: marketPrices MarketPrice[]
model MarketPrice {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemType     String   @map("item_type") // FEED_RETAIL | RAW_MATERIAL | LIVE_BIRD | EGGS | MEAT | MILK | CHICKS | VET | PULSE | FORAGE
  itemName     String   @map("item_name")
  brand        String?
  packSizeKg   Decimal? @map("pack_size_kg") @db.Decimal(8, 2)
  competitorId String?  @map("competitor_id")
  unit         String
  priceMinEgp  Decimal  @map("price_min_egp") @db.Decimal(12, 2)
  priceMaxEgp  Decimal  @map("price_max_egp") @db.Decimal(12, 2)
  governorate  String?
  markaz       String?
  observedAt   DateTime @map("observed_at")
  source       String // REP_FIELD | WEB | BULLETIN | CUSTOMER | AGENT
  sourceUrl    String?  @map("source_url")
  confidence   Int // 1..3
  recordedById String   @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([itemType, observedAt])
  @@map("market_prices")
}

// ───────────── H. المنافسين (المرحلة 3) ─────────────
// يتضاف جوه model Company: competitors Competitor[]
model Competitor {
  id           String              @id @default(uuid())
  companyId    String              @map("company_id")
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  type         String // FEED_MILL | LOCAL_MILL | DISTRIBUTOR | VET_PHARMACY | IMPORTER | VILLAGE_DEALER
  governorates String[]
  notes        String?
  products     CompetitorProduct[]

  @@index([companyId])
  @@map("competitors")
}

model CompetitorProduct {
  id           String     @id @default(uuid())
  competitorId String     @map("competitor_id")
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  name         String
  category     String
  species      Species?
  packSizeKg   Decimal?   @map("pack_size_kg") @db.Decimal(8, 2)
  lastPriceEgp Decimal?   @map("last_price_egp") @db.Decimal(12, 2)
  firstSeenAt  DateTime   @default(now()) @map("first_seen_at")
  notes        String?

  @@map("competitor_products")
}

// ───────────── I. مهام ميدانية للمندوبين (المرحلة 3) ─────────────
// يتضاف جوه model Company: fieldTasks FieldTask[]
model FieldTask {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedToId String   @map("assigned_to_id")
  customerId   String?  @map("customer_id")
  type         String // VISIT | SURVEY | PRICE_CHECK | SAMPLE_TRIAL
  instructions String
  dueAt        DateTime @map("due_at")
  status       String   @default("DRAFT") // DRAFT | APPROVED | DONE | CANCELLED
  result       Json?
  createdById  String   @map("created_by_id")
  approvedById String?  @map("approved_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("field_tasks")
}

// ───────────── J. لقطة يومية لمقاييس العميل (المرحلة 3) ─────────────
// يتضاف جوه model Company: customerMetrics CustomerMetric[]
model CustomerMetric {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String   @map("customer_id")
  asOf            DateTime @map("as_of")
  recencyDays     Int      @map("recency_days")
  orders90d       Int      @map("orders_90d")
  spend90d        Decimal  @map("spend_90d") @db.Decimal(12, 2)
  avgIntervalDays Decimal? @map("avg_interval_days") @db.Decimal(8, 2)
  churnRisk       Decimal? @map("churn_risk") @db.Decimal(4, 3)
  segmentLabel    String?  @map("segment_label")

  @@unique([customerId, asOf])
  @@index([companyId])
  @@map("customer_metrics")
}

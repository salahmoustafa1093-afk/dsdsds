// إضافات مقترحة على gff-backend/prisma/schema.prisma عشان "رادار" والمتابعة تشتغل.
// ده اقتراح للمراجعة مش migration جاهزة: أسماء العلاقات والـ relations العكسية لازم تتظبط مع الموديلات الموجودة.
// الترتيب حسب الأولوية: A و B في المرحلة 2، والباقي في المرحلة 3.

// ───────────── A. توسيع Customer ─────────────
// يتضاف جوه model Customer:
//   segment            BreederSegment?
//   governorate        String?
//   markaz             String?
//   village            String?
//   latitude           Decimal?        @db.Decimal(10, 6)
//   longitude          Decimal?        @db.Decimal(10, 6)
//   whatsappPhone      String?
//   contactConsent     Boolean         @default(false)
//   consentAt          DateTime?
//   consentSource      String?         // rep | branch | whatsapp_optin
//   optOutAt           DateTime?
//   acquisitionSource  String?         // rep | branch | referral | ad
//   lifecycleStage     LifecycleStage  @default(LEAD)
//   lifecycleUpdatedAt DateTime?
//   herds              CustomerHerd[]
//   interactions       CustomerInteraction[]
//   @@index([segment])
//   @@index([governorate])
//   @@index([lifecycleStage])

enum BreederSegment {
  HOUSEHOLD    // تربية منزلية
  SMALL_FARM   // مزرعة صغيرة
  MEDIUM_FARM
  COMMERCIAL
}

enum LifecycleStage {
  LEAD
  NEW
  ACTIVE
  GROWING
  KEY
  AT_RISK
  DORMANT
  CHURNED
}

// ───────────── B. القطيع / الطيور عند العميل ─────────────
enum Species {
  BROILER
  LAYER
  BALADI_CHICKEN
  SASSO
  DUCK
  GOOSE
  TURKEY
  PIGEON
  QUAIL
  RABBIT
  CATTLE
  BUFFALO
  SHEEP
  GOAT
  CAMEL
  FISH
  OTHER
}

enum HerdPurpose {
  MEAT
  EGGS
  MILK
  FATTENING
  BREEDING
  MIXED
}

enum FeedSource {
  GFF
  COMPETITOR
  HOME_MIX
  LOCAL_MILL
  MIXED
  UNKNOWN
}

enum DataSource {
  REP
  SURVEY
  WHATSAPP
  AGENT_INFERRED
}

model CustomerHerd {
  id                String     @id @default(uuid())
  customerId        String
  customer          Customer   @relation(fields: [customerId], references: [id])
  species           Species
  headCount         Int
  purpose           HerdPurpose
  cycleStartDate    DateTime?
  expectedCycleEnd  DateTime?
  currentFeedSource FeedSource @default(UNKNOWN)
  currentFeedBrand  String?
  monthlyFeedKg     Decimal?   @db.Decimal(10, 2)
  dataSource        DataSource
  recordedById      String
  recordedAt        DateTime   @default(now())

  @@index([customerId])
  @@index([species])
}

// ───────────── C. سجل التفاعلات ─────────────
enum InteractionType {
  CALL
  VISIT
  WHATSAPP_IN
  WHATSAPP_OUT
  COMPLAINT
  SURVEY
  INTERVIEW
  WALK_IN
}

model CustomerInteraction {
  id         String          @id @default(uuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  type       InteractionType
  summary    String
  rawText    String?
  sentiment  Int?            // -2 .. +2
  tags       String[]
  productId  String?
  userId     String
  createdAt  DateTime        @default(now())

  @@index([customerId, createdAt])
}

// ───────────── D. رسايل واتساب (الخدمة الحالية بتخزنها في الذاكرة المؤقتة وبتضيع) ─────────────
model WhatsAppMessage {
  id           String   @id @default(uuid())
  waMessageId  String   @unique
  customerId   String?
  phone        String
  direction    String   // IN | OUT
  type         String
  body         String?
  templateName String?
  status       String
  createdAt    DateTime @default(now())

  @@index([customerId])
}

// ───────────── E. الاستبيانات ─────────────
enum SurveyStatus {
  DRAFT
  APPROVED
  LIVE
  CLOSED
}

model Survey {
  id            String          @id @default(uuid())
  title         String
  purpose       String
  targetSegment BreederSegment?
  targetSpecies Species?
  questions     Json
  channel       String          // REP | WHATSAPP
  status        SurveyStatus    @default(DRAFT)
  createdById   String
  approvedById  String?
  createdAt     DateTime        @default(now())
  responses     SurveyResponse[]
}

model SurveyResponse {
  id           String   @id @default(uuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id])
  customerId   String?
  answers      Json
  collectedVia String   // REP | WHATSAPP
  consent      Boolean
  collectedAt  DateTime @default(now())

  @@index([surveyId])
}

// ───────────── F. مسار المنتجات الجديدة ─────────────
enum IdeaStage {
  IDEA
  DESK_RESEARCH
  FIELD_VALIDATION
  PILOT
  LAUNCHED
  REVIEW_90D
  STOPPED
}

model ProductIdea {
  id                String           @id @default(uuid())
  code              String           @unique // OPP-001
  title             String
  description       String
  category          String           // FEED | PULSES | VET | SUPPLIES | ADDITIVE | SERVICE
  targetSpecies     Species[]
  targetSegment     BreederSegment[]
  problemStatement  String
  evidence          Json
  estPriceEgp       Decimal?         @db.Decimal(12, 2)
  estUnitCostEgp    Decimal?         @db.Decimal(12, 2)
  needsRegistration Boolean          @default(false)
  stage             IdeaStage        @default(IDEA)
  score             Decimal?         @db.Decimal(4, 1) // من 35
  pilotBranchId     String?
  createdById       String
  ownerId           String
  decidedById       String?
  decidedAt         DateTime?
  launchedProductId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// يتضاف جوه model Product:
//   launchDate    DateTime?
//   isPilot       Boolean   @default(false)
//   targetSpecies Species[]
//   packSizeKg    Decimal?  @db.Decimal(8, 2)
//   feedFormulaId String?

// ───────────── G. أسعار السوق ─────────────
model MarketPrice {
  id           String   @id @default(uuid())
  itemType     String   // FEED_RETAIL | RAW_MATERIAL | LIVE_BIRD | EGGS | MEAT | MILK | CHICKS | VET | PULSE | FORAGE
  itemName     String
  brand        String?
  competitorId String?
  unit         String
  priceMinEgp  Decimal  @db.Decimal(12, 2)
  priceMaxEgp  Decimal  @db.Decimal(12, 2)
  governorate  String?
  markaz       String?
  observedAt   DateTime
  source       String   // REP_FIELD | WEB | BULLETIN | CUSTOMER | AGENT
  sourceUrl    String?
  confidence   Int      // 1..3
  recordedById String
  createdAt    DateTime @default(now())

  @@index([itemType, observedAt])
}

// ───────────── H. المنافسين ─────────────
model Competitor {
  id          String              @id @default(uuid())
  name        String
  type        String              // FEED_MILL | LOCAL_MILL | DISTRIBUTOR | VET_PHARMACY | IMPORTER | VILLAGE_DEALER
  governorates String[]
  notes       String?
  products    CompetitorProduct[]
}

model CompetitorProduct {
  id           String     @id @default(uuid())
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id])
  name         String
  category     String
  species      Species?
  packSizeKg   Decimal?   @db.Decimal(8, 2)
  lastPriceEgp Decimal?   @db.Decimal(12, 2)
  firstSeenAt  DateTime   @default(now())
  notes        String?
}

// ───────────── I. مهام ميدانية للمندوبين ─────────────
model FieldTask {
  id           String    @id @default(uuid())
  assignedToId String
  customerId   String?
  type         String    // VISIT | SURVEY | PRICE_CHECK | SAMPLE_TRIAL
  instructions String
  dueAt        DateTime
  status       String    @default("OPEN") // OPEN | DONE | CANCELLED
  result       Json?
  createdById  String
  approvedById String?
  createdAt    DateTime  @default(now())
}

// ───────────── J. لقطة يومية لمقاييس العميل ─────────────
model CustomerMetric {
  id              String   @id @default(uuid())
  customerId      String
  asOf            DateTime
  recencyDays     Int
  orders90d       Int
  spend90d        Decimal  @db.Decimal(12, 2)
  avgIntervalDays Decimal? @db.Decimal(8, 2)
  churnRisk       Decimal? @db.Decimal(4, 3)
  segmentLabel    String?

  @@unique([customerId, asOf])
}
